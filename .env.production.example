# PrimeBrew Herbis - Production Environment Configuration

# Application
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://yourdomain.com
PORT=3000

# PostgreSQL Database (e.g. AWS RDS / OCI Autonomous Database)
DATABASE_URL=postgresql://primebrew_user:SecurePassword123@your-db-host.rds.amazonaws.com:5432/primebrew_herbis?schema=public&sslmode=require

# JWT Secret (Generate 64-character random hex via: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=replace_with_64_character_hex_secret

# Administrator Credentials
ADMIN_EMAIL=contact.primebrew@gmail.com
ADMIN_PASSWORD=replace_with_complex_production_password
ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash

# Email Dispatch via Resend (HTTP API)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=PrimeBrew Herbis <orders@yourdomain.com>

# Optional Upstash Redis for Distributed Multi-Instance Rate Limiting
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here
