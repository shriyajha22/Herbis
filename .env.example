# PrimeBrew Herbis - Production & Preview Environment Variables
# Configure these variables in your Vercel Project Settings -> Environment Variables.

# 1. MongoDB Atlas Database Connection String (Already configured in Vercel - DO NOT duplicate or replace)
MONGODB_URI=mongodb+srv://primebrew_app:<password>@cluster.mongodb.net/primebrew?retryWrites=true&w=majority

# 2. Admin Credentials
ADMIN_EMAIL=Contact.primebrew@gmail.com
ADMIN_PASSWORD=your_secure_admin_password_here

# 3. JWT Signing Secret
JWT_SECRET=your_secure_jwt_signing_secret_here

# 4. Nodemailer Gmail SMTP Configuration (For Password Reset Delivery)
# Note: SMTP_PASS must be a 16-character Gmail App Password (from Google Account -> Security -> App Passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=Contact.primebrew@gmail.com
SMTP_PASS=your_16_char_gmail_app_password_here
SMTP_FROM="PrimeBrew Herbis" <Contact.primebrew@gmail.com>

# 5. Production Application Base URL
NEXT_PUBLIC_APP_URL=https://primebrew-herbis.vercel.app